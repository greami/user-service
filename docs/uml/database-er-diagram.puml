@startuml
title User Service - Database Entity Relationship Diagram

hide circle
skinparam linetype ortho

entity "UTENTE" as UTENTE {
  * ID : INTEGER <<PK, IDENTITY>>
  --
  * NOMEUTENTE : VARCHAR(50) <<UNIQUE>>
  * NOME : VARCHAR(50)
  * COGNOME : VARCHAR(50)
  * EMAIL : VARCHAR(100) <<UNIQUE>>
  * PASSWORD : VARCHAR(255)
}

entity "RUOLO" as RUOLO {
  * ID : INTEGER <<PK>>
  --
  * NOME : VARCHAR(100)
  * DESCRIZIONE : VARCHAR(255)
}

entity "UTENTE_RUOLO" as UTENTE_RUOLO {
  * ID : INTEGER <<PK, IDENTITY>>
  --
  * IDUTENTE : BIGINT <<FK>>
  * IDRUOLO : BIGINT <<FK>>
  ..
  UK_UR : UNIQUE (IDUTENTE, IDRUOLO)
}

UTENTE ||--o{ UTENTE_RUOLO : "FK_UR_UTENTE"
RUOLO ||--o{ UTENTE_RUOLO : "FK_UR_RUOLO"

note right of UTENTE
  ID: GENERATED BY DEFAULT AS IDENTITY
  START WITH 6000
  NOMEUTENTE ed EMAIL sono NOT NULL e UNIQUE.
end note

note right of UTENTE_RUOLO
  ID: GENERATED BY DEFAULT AS IDENTITY
  START WITH 6000
  IDUTENTE e IDRUOLO sono NOT NULL.
  La coppia (IDUTENTE, IDRUOLO) è univoca.
end note

@enduml
